# FastAPI application name shown in docs
APP_NAME=Formula Recognition API
# Base API prefix for all endpoints
API_PREFIX=/api/v1
# API semantic version
API_VERSION=0.1.0
# Logging level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
# Comma-separated allowed browser origins for CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Separator line length for endpoint logs
LOG_SEPARATOR_LENGTH=80
# Decimal precision for timing logs
DURATION_DECIMALS=2

# Base directory containing model files (absolute or relative to project root)
MODEL_DIR=backend\model
# Model checkpoint filename (or relative path under MODEL_DIR)
MODEL_CHECKPOINT_FILE=best_acc.pt
# Model vocabulary filename (or relative path under MODEL_DIR)
MODEL_VOCAB_FILE=vocab.json

# Default image size for preprocessing
IMAGE_HEIGHT=128
IMAGE_WIDTH=512
# Padding fill value for image background (0-255)
IMAGE_PADDING_FILL=255
# Normalization mean per channel, comma-separated
IMAGE_NORMALIZE_MEAN=0.5,0.5,0.5
# Normalization std per channel, comma-separated
IMAGE_NORMALIZE_STD=0.5,0.5,0.5
# Max decoding length
MAX_DECODE_LEN=256

# Upload storage directory (absolute or relative to project root)
UPLOAD_DIR=uploaded_documents
# Maximum upload size in megabytes
MAX_UPLOAD_MB=10
# Upload read chunk size in megabytes
UPLOAD_CHUNK_MB=1
# Allowed MIME types (comma-separated)
ALLOWED_IMAGE_TYPES=image/png,image/jpeg,image/webp
# Allowed file extensions (comma-separated)
ALLOWED_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.webp

# Text-to-speech settings
# Output directory for generated audio (absolute or relative to project root)
TTS_OUTPUT_DIR=generated_audio
# Default speech rate
TTS_RATE=200
# Default speech volume (0.0-1.0)
TTS_VOLUME=1.0
# Default language for speech (e.g., en, zh, yue)
TTS_DEFAULT_LANGUAGE=en
# Default voice ID (optional, leave blank for system default)
TTS_VOICE_ID=
# Audio format for generated speech files (currently supports wav)
TTS_AUDIO_FORMAT=wav

# Device preference: auto, cpu, or cuda
DEVICE_PREFERENCE=auto


###============================== LLM API Key Configuration ==============================###
# Global selection (you can switch by changing LLM_PROVIDER or LLM_MODEL at runtime)
LLM_PROVIDER=         # Optional: openai | azure | anthropic | huggingface | cohere | local ...
LLM_MODEL=             # The model name currently in use (interpreted by the corresponding provider)
LLM_DEFAULT_MODEL=     # Backup default model

# API Keys / configurations for each provider (fill in as needed)
OPENAI_API_KEY=
OPENAI_API_BASE=       # Optional: set for OpenAI-compatible servers (base URL, without /v1)
OPENAI_ORG=

AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=              # e.g., https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=             # Deployment name when using Azure OpenAI (can override LLM_MODEL)
AZURE_OPENAI_API_VERSION=

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1/messages
ANTHROPIC_API_VERSION=2023-06-01

HUGGINGFACE_API_KEY=
HUGGINGFACE_API_BASE=https://api-inference.huggingface.co/models

COHERE_API_KEY=
COHERE_API_BASE=https://api.cohere.ai/v1/generate

# Other controls (timeouts, concurrency, etc.)
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_RETRIES=2
###============================== LLM API Key Configuration ==============================###
